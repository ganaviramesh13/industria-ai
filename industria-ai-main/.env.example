# =============================================================================
# INDUSTRIA AI — Environment Configuration
# =============================================================================
# Instructions:
# 1. Copy this file to .env:
#      copy .env.example .env
# 2. Add your official Groq API key below.
#    Get an API key for free from: https://console.groq.com/keys
# =============================================================================

# Django Core
DJANGO_SECRET_KEY=django-insecure-industria-ai-master-key-prod-2026
DEBUG=True
ALLOWED_HOSTS=*

# Database Configuration (leave as sqlite for local development)
DB_ENGINE=sqlite
DB_NAME=industria_ai
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# =============================================================================
# PRIMARY LLM: Official Groq API (Groq Inc.)
# =============================================================================
# Supported Groq Models:
# - llama-3.3-70b-versatile (Recommended default)
# - llama-3.1-70b-versatile
# - llama-3.1-8b-instant
# - mixtral-8x7b-32768
GROQ_API_KEY=your_actual_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# =============================================================================
# Fallback LLM Providers (Optional)
# =============================================================================
OPENAI_API_KEY=
GEMINI_API_KEY=

# =============================================================================
# Vector Embeddings
# =============================================================================
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
